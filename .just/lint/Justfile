set working-directory := "../.."

[private]
default:
    just --list --justfile {{source_file()}}

# Lint Markdown files
markdown:
    rumdl check .

# Lint YAML files
yaml:
    yamlfmt -lint lefthook.yml webapp/pnpm-workspace.yaml

# Lint the webapp (ESLint)
webapp:
    pnpm -C webapp lint:check

# Check Terraform formatting
terraform:
    just infra fmt-check

# Run every linter
all: markdown yaml webapp terraform
