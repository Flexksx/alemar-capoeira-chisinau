set working-directory := "../.."

[private]
default:
    just --list --justfile {{source_file()}}

# Format Nix files
nix:
    alejandra .

# Format Markdown files
markdown:
    rumdl check --fix .

# Format YAML files
yaml:
    yamlfmt lefthook.yml webapp/pnpm-workspace.yaml

# Format the webapp (TypeScript/Svelte, via Prettier)
webapp:
    pnpm -C webapp format

# Run every formatter
all: nix markdown yaml webapp
