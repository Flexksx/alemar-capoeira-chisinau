{
	"name": "alemar-capoeira",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "biome format --write src && prettier --write --ignore-path ../../.prettierignore src",
		"lint": "biome format src && prettier --check --ignore-path ../../.prettierignore src && eslint src && pnpm run check && depcruise src --config .dependency-cruiser.cjs"
	},
	"devDependencies": {
		"@alemar/songs": "workspace:*",
		"@alemar/ui": "workspace:*",
		"@lucide/svelte": "catalog:",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@typescript/native": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"wrangler": "^4.143.0"
	},
	"dependencies": {
		"mode-watcher": "^1.1.0"
	}
}
